{
	"name": "Hugo + Python",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
	"features": {
		"ghcr.io/devcontainers-contrib/features/hugo:1": {
			"version": "0.165.0",
			"extended": true
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"budparr.language-hugo-vscode"
			]
		}
	},
	"postCreateCommand": "pip install --no-cache-dir -r backend/requirements.txt",
	"remoteUser": "vscode"
}
